# Copy to .env.local for local development. NEVER commit real values.
# Production/preview secrets live ONLY in the hosting provider's secret manager.

# --- Public, non-secret ---
# development | preview | production  (anything except production is noindex)
APP_ENV=development
# Canonical origin: canonical URLs, sitemap, OG, and (at BUILD time) HSTS/CSP. Must be https in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where admin-edited content and uploads are stored. Mount a persistent volume here in production.
DATA_DIR=.data

# --- Secrets (server-only; generate with `node scripts/gen-admin-credentials.mjs --totp`) ---
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
# SESSION_SECRET=            # >= 32 chars
# ADMIN_TOTP_SECRET=         # optional two-factor
# ADMIN_SESSION_VERSION=1    # bump to sign out every session

# Set to "static" only when building the free static-hosting version (use `npm run build:static`, which sets it).
# DEPLOY_TARGET=static
